# 复制成 backend/.env 后填入真实值。这个文件本身不含任何密钥，可以进版本库。

# ---------- LLM（AI 补全用，走 OpenAI 兼容接口）----------
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=在这里填你的-key
LLM_MODEL=deepseek-chat

# ---------- 补全开关 ----------
# 关掉之后导入照样能跑，只是空缺的音标和释义会一直空着
ENRICH_ENABLED=true
# 是否先用在线词典查（能查到就不花 LLM 的钱）
ENRICH_USE_DICTIONARY_API=true

# ---------- 学习节奏 ----------
# 每日新词配额，前端界面上也能改
DAILY_NEW_LIMIT=20
